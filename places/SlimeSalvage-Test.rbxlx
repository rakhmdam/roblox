      <Item class="ModuleScript" referent="RBX332">
        <Properties>
          <string name="Name">BuildConfig</string>
          <ProtectedString name="Source">--!strict
-- This build deliberately has no DataStore or purchase integration.
return table.freeze({
	buildVersion = "beta-implementation-0.1.0-dev",
	environment = "Test",
	balanceVersion = "balance-0.1.0",
	persistenceEnabled = true,
	monetizationEnabled = false,
	randomOperationsEnabled = true,
	analyticsEnabled = true,
	-- Bind only IDs of the project's uploaded audio. Empty IDs intentionally stay silent.
	audio = {music="rbxassetid://77885621577161",collect="rbxassetid://117150528054674",confirm="rbxassetid://104458299374083"},
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX333">
        <Properties>
          <string name="Name">Catalog</string>
          <ProtectedString name="Source">--!strict
local C = {
	schemaVersion=1, balanceVersion="balance-0.1.0", protocolVersion=2,
	coinLimit=1000000000, itemLimit=1000000,
	order={"shore", "bay", "cave"},
	islands={
		shore={index=1, ru="Зелёный берег", en="Green Shore", price=0, hp=12, coins=6, power=2,
			factor=1, incubation=80, tea=30, trait=40, materials={70,30,0}, x=0},
		bay={index=2, ru="Железная бухта", en="Iron Bay", price=1500, hp=42, coins=24, power=7,
			factor=4, incubation=360, tea=120, trait=180, materials={20,75,5}, x=400},
		cave={index=3, ru="Кристальные пещеры", en="Crystal Caves", price=9000, hp=120, coins=72, power=20,
			factor=12, incubation=1500, tea=360, trait=750, materials={10,20,70}, x=800},
	},
	materials={"Plastic", "Metal", "Crystal"},
	rarityRu={"Обычный", "Необычный", "Редкий", "Эпический", "Легендарный"},
	rarityEn={"Common", "Uncommon", "Rare", "Epic", "Legendary"},
	junkWeights={6000,2500,1000,400,100}, slimeWeights={5500,2700,1200,500,100},
	hpMultipliers={1,1.3,1.8,2.6,4}, coinMultipliers={1,1.6,2.5,4,7}, amounts={1,2,3,5,8},
	rarityPower={1,1.12,1.25,1.4,1.6}, rankFactors={1,2,3,5,8}, rankPrices={2,5,10},
	recycle={1,2,5,12,30}, craft={8,15,30,80,200},
	tool={values={4,6,9,14,21}, prices={0,30,180,900,3600}, access={1,1,1,2,3}},
	bag={values={12,20,32,48,72}, prices={0,60,240,960,3840}, access={1,1,1,2,3}},
	storage={values={30,60,100}, prices={0,600,2400}, access={1,2,3}},
	species={} :: {[string]: any}, speciesOrder={} :: {string}, sets={} :: {[string]: {string}},
	evolutions={
		shore_sprout={id="iron_sprout", ru="Железный Росток", en="Iron Sprout", island="bay", coins=250, material="Metal", amount=30, role="Breaker"},
		bay_bolt={id="magnetic_bolt", ru="Магнитный Болтик", en="Magnetic Bolt", island="bay", coins=1000, material="Metal", amount=100, role="Breaker"},
		cave_shard={id="crystal_guard", ru="Кристальный Страж", en="Crystal Guard", island="cave", coins=3000, material="Crystal", amount=120, role="Sweeper"},
	},
	traits={"sturdy", "nimble", "metalwork", "crystalwork"}, traitWeights={4000,3000,2000,1000},
	decor={} :: {[string]: any}, decorOrder={} :: {string}, restoration={0,50,200,600},
}
local rows = {
	{"shore_sprout","Росток","Sprout","Collector"}, {"shore_tide","Капля","Tide","Collector"},
	{"shore_moss","Моховик","Moss","Sweeper"}, {"shore_pollen","Пыльцевик","Pollen","Support"},
	{"shore_sun","Солнечный","Sunny","Sweeper"}, {"bay_scrap","Жестянка","Scrap","Collector"},
	{"bay_bolt","Болтик","Bolt","Breaker"}, {"bay_magnet","Магнитик","Magnet","Collector"},
	{"bay_furnace","Печник","Furnace","Breaker"}, {"bay_titan","Титан","Titan","Breaker"},
	{"cave_shard","Осколок","Shard","Collector"}, {"cave_quartz","Кварцик","Quartz","Collector"},
	{"cave_echo","Эхо","Echo","Sweeper"}, {"cave_prism","Призма","Prism","Support"},
	{"cave_nova","Нова","Nova","Sweeper"},
}
for index, row in rows do
	local island = C.order[math.ceil(index/5)]
	C.species[row[1]] = {id=row[1], ru=row[2], en=row[3], role=row[4], island=island, rarity=(index-1)%5+1}
	table.insert(C.speciesOrder, row[1])
	if not C.sets[island] then C.sets[island] = {} end
	table.insert(C.sets[island], row[1])
end
local decorations = {
	{"planter","Клумба","Planter"}, {"bench","Скамья","Bench"}, {"lantern","Фонарь","Lantern"},
	{"banner","Флаг","Banner"}, {"gear","Шестерня","Gear"}, {"pipe","Труба","Pipe"},
	{"robot","Робот","Robot"}, {"crystal","Кристалл","Crystal"}, {"arch","Арка","Arch"},
	{"prism","Призма","Prism"},
}
for index, row in decorations do
	local island = if index&lt;=4 then "shore" elseif index&lt;=7 then "bay" else "cave"
	C.decor[row[1]] = {ru=row[2], en=row[3], island=island, price=if index&lt;=4 then 50 elseif index&lt;=7 then 250 else 1000}
	table.insert(C.decorOrder, row[1])
end
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX334">
        <Properties>
          <string name="Name">Protocol</string>
          <ProtectedString name="Source">--!strict
local Protocol={}
local schemas: {[string]: {[string]: string}}={
	Sync={},Play={},Pause={},CancelTarget={},ReturnHome={},
	SelectTarget={nodeId="int"},SelectEvent={},ProcessCargo={},ViewNursery={},SkipTutorial={},
	BuyUpgrade={kind="string",expectedTier="int"},UnlockIsland={island="string"},Travel={island="string"},
	VisitBase={userId="int"},EquipTeam={uids="uids"},LockSlime={uid="string",locked="boolean"},
	LevelSlime={uid="string",expectedLevel="int"},RankSlime={uid="string",expectedRank="int"},
	EvolveSlime={uid="string",recipeId="string"},Incubate={island="string"},
	CraftSlime={island="string",speciesId="string"},RecycleSlimes={uids="uids"},BuyTea={},
	RollTrait={target="string"},ResolveTrait={offerId="string",accept="boolean"},
	BuyDecoration={itemId="string"},PlaceDecoration={itemId="string",slot="int"},
	UpdateSettings={language="optionalString",music="optionalBoolean",sound="optionalBoolean",
		lowEffects="optionalBoolean",reducedMotion="optionalBoolean",autoRepeat="optionalBoolean",allowGuests="optionalBoolean"},
	Modal={open="boolean"},
}
local function valid(value: any,kind: string): boolean
	if kind=="optionalString" then return value==nil or valid(value,"string") end
	if kind=="optionalBoolean" then return value==nil or type(value)=="boolean" end
	if kind=="string" then return type(value)=="string" and #value&lt;=64 and #value&gt;0 and utf8.len(value)~=nil end
	if kind=="boolean" then return type(value)=="boolean" end
	if kind=="int" then return type(value)=="number" and value==value and value&gt;=0 and value&lt;=1e12 and value%1==0 end
	if kind=="uids" then
		if type(value)~="table" or #value&gt;20 then return false end
		local keys=0
		for k,v in value do if type(k)~="number" or k%1~=0 or k&lt;1 or k&gt;#value or not valid(v,"string") then return false end; keys+=1 end
		return keys==#value
	end
	return false
end
function Protocol.validate(request: any): boolean
	if type(request)~="table" then return false end
	local keys=0
	for key in request do
		keys+=1
		if key~="protocolVersion" and key~="requestId" and key~="sessionNonce" and key~="action" and key~="payload" then return false end
	end
	if keys&gt;5 or request.protocolVersion~=2 or not valid(request.requestId,"string")
		or not string.match(request.requestId,"^[%w%-]+$") or not valid(request.action,"string") then return false end
	if request.action~="Sync" and not valid(request.sessionNonce,"string") then return false end
	local schema=schemas[request.action]
	if not schema or type(request.payload)~="table" then return false end
	local n=0
	for key in request.payload do n+=1; if not schema[key] or n&gt;10 then return false end end
	for key,kind in schema do
		if request.action=="PlaceDecoration" and key=="itemId" and request.payload[key]=="" then continue end
		if not valid(request.payload[key],kind) then return false end
	end
	return true
end
return Protocol
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX335">
