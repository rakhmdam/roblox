  <Item class="ReplicatedStorage" referent="RBX18">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX19">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">BuildConfig</string>
          <ProtectedString name="Source">--!strict
-- This build deliberately has no DataStore or purchase integration.
return table.freeze({
	buildVersion = "foundation-0.0.1",
	environment = "Test",
	balanceVersion = "balance-0.1.0",
	persistenceEnabled = false,
	monetizationEnabled = false,
})
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX24">
      <Properties>
        <string name="Name">Bootstrap</string>
        <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BuildConfig"))

assert(config.environment == "Test", "Foundation build must run in Test")
assert(not config.persistenceEnabled and not config.monetizationEnabled)
assert(workspace:WaitForChild("ShoreArt"):FindFirstChild("WelcomeSpawn"))
ReplicatedStorage:SetAttribute("BuildVersion", config.buildVersion)
print("Slime Salvage foundation ready; persistence and purchases disabled")
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX21">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX25">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BuildConfig"))
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "BuildStatus"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local status = Instance.new("TextLabel")
status.Name = "Status"
status.Size = UDim2.new(1, -32, 0, 72)
status.Position = UDim2.fromOffset(16, 12)
status.BackgroundColor3 = Color3.fromRGB(30, 53, 54)
status.BackgroundTransparency = 0.15
status.TextColor3 = Color3.fromRGB(240, 242, 220)
status.TextWrapped = true
status.TextSize = 18
status.Font = Enum.Font.GothamMedium
status.Text = "SLIME SALVAGE · " .. config.buildVersion
	.. "\nТестовая сцена. Сбор и сохранения ещё не подключены."
status.Parent = gui
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>