  <Item class="ServerScriptService" referent="RBX329">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX336">
      <Properties>
        <string name="Name">Analytics</string>
        <ProtectedString name="Source">--!strict
local RunService=game:GetService("RunService")
local Service=game:GetService("AnalyticsService")
local Analytics={}
function Analytics.funnel(player: Player,step: number,name: string,enabled: boolean)
	if not enabled or RunService:IsStudio() then return end
	task.spawn(function() pcall(function() Service:LogFunnelStepEvent(player,"Onboarding","",step,name) end) end)
end
function Analytics.economy(player: Player,action: string,change: number,balance: number,enabled: boolean)
	if not enabled or change==0 or RunService:IsStudio() then return end
	task.spawn(function() pcall(function()
		Service:LogEconomyEvent(player,if change&gt;0 then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink,
			"Coins",math.abs(change),balance,"Gameplay",action)
	end) end)
end
function Analytics.custom(player: Player,name: string,enabled: boolean)
	if not enabled or RunService:IsStudio() then return end
	task.spawn(function() pcall(function() Service:LogCustomEvent(player,name,1) end) end)
end
return Analytics
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX337">
      <Properties>
        <string name="Name">BaseService</string>
        <ProtectedString name="Source">--!strict
local Base={}
local slots: {[number]: Player}={}
function Base.origin(slot: number): Vector3
	return Vector3.new(((slot-1)%4-1.5)*150,0,-240-math.floor((slot-1)/4)*150)
end
function Base.claim(player: Player): number?
	for slot=1,8 do if not slots[slot] then slots[slot]=player; return slot end end
	return nil
end
function Base.release(slot: number)
	slots[slot]=nil
	local model=workspace:FindFirstChild("Base"..tostring(slot))
	if model then
		model:SetAttribute("OwnerId",nil)
		local decor=model:FindFirstChild("PlacedDecor"); if decor then decor:ClearAllChildren() end
	end
end
function Base.paint(player: Player,s: any,c: any)
	local model=workspace:FindFirstChild("Base"..tostring(s.slot))
	if not model then return end
	local signature=tostring(s.profile.base.restorationTier)
	for slot=1,12 do signature..="/"..(s.profile.base.decorationSlots[tostring(slot)] or "-") end
	if s.baseArtSignature==signature then return end
	s.baseArtSignature=signature
	model:SetAttribute("OwnerId",player.UserId); model:SetAttribute("Restoration",s.profile.base.restorationTier)
	local garden=model:FindFirstChild("Garden")
	if garden and garden:IsA("BasePart") then
		local colors={Color3.fromRGB(143,142,100),Color3.fromRGB(126,157,92),Color3.fromRGB(104,172,91),Color3.fromRGB(85,192,107)}
		garden.Color=colors[s.profile.base.restorationTier]
	end
	local folder=model:FindFirstChild("PlacedDecor")
	if not folder then folder=Instance.new("Folder"); folder.Name="PlacedDecor"; folder.Parent=model end
	folder:ClearAllChildren()
	for slot,id in s.profile.base.decorationSlots do
		local n=tonumber(slot) :: number
		local index=table.find(c.decorOrder,id) or 1
		local p=Instance.new("Part")
		p.Name=id; p.Anchored=true; p.CanCollide=false
		p.Shape=if index%3==0 then Enum.PartType.Ball elseif index%3==1 then Enum.PartType.Block else Enum.PartType.Cylinder
		p.Size=Vector3.new(2+index%3,1+index%4,2+index%2)
		p.Color=Color3.fromHSV(index/10,0.45,0.9)
		p.Position=Base.origin(s.slot)+Vector3.new(if n%2==0 then 23 else -23,2+p.Size.Y/2,-24+math.floor((n-1)/2)*9)
		p.Parent=folder
	end
end
return Base
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX338">
      <Properties>
        <string name="Name">BetaServer</string>
        <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Http=game:GetService("HttpService")
local shared=ReplicatedStorage:WaitForChild("Shared")
local C=require(shared:WaitForChild("Catalog"))
local Config=require(shared:WaitForChild("BuildConfig"))
local Protocol=require(shared:WaitForChild("Protocol"))
local Schema=require(script.Parent:WaitForChild("ProfileSchema"))
local Game=require(script.Parent:WaitForChild("GameDomain"))
local Store=require(script.Parent:WaitForChild("ProfileStore"))
local Resources=require(script.Parent:WaitForChild("ResourceService"))
local Base=require(script.Parent:WaitForChild("BaseService"))
local Analytics=require(script.Parent:WaitForChild("Analytics"))
local Server={}
function Server.start()
	assert(Config.persistenceEnabled and not Config.monetizationEnabled,"Only persistent free beta is implemented")
	local store=Store.new(Config,C)
	local remote=Instance.new("RemoteEvent"); remote.Name="BetaSession"; remote.Parent=ReplicatedStorage
	local sessions: {[Player]: any}={}
	local loading: {[Player]: boolean}={}
	local rejected: {[Player]: number}={}
	local function rejectLog(player: Player,code: string)
		local now=os.clock()
		if now-(rejected[player] or -10)&gt;=5 then
			rejected[player]=now
			warn("SlimeSalvage rejected",player.UserId,code)
			Analytics.custom(player,"RejectedRequest",Config.analyticsEnabled)
		end
	end
	local random=Random.new()
	local function integer(a: number,b: number): number return random:NextInteger(a,b) end
	local function uid(): string return Http:GenerateGUID(false) end
	local function root(player: Player): BasePart?
		local char=player.Character
		local human=if char then char:FindFirstChildOfClass("Humanoid") else nil
		local part=if char then char:FindFirstChild("HumanoidRootPart") else nil
		return if human and human.Health&gt;0 and part and part:IsA("BasePart") then part else nil
	end
	local event: any={id="",active=false,nextAt=os.time()+600,endsAt=0,hp=0,maxHp=0,cycles={},last={},rewards={}}
	local eventPosition=Vector3.new(400,5,-50)
	local function send(player: Player,s: any,errorCode: string?,requestId: string?,result: any?)
		if not player.Parent or not s.ready then return end
		s.viewRevision+=1
		local chances={}
		for _,id in C.order do chances[id]=Game.weights(s.profile,id,C) end
		local publicBases={}
		local companions={}
		for owner,other in sessions do
			table.insert(publicBases,{userId=owner.UserId,name=owner.DisplayName,slot=other.slot,guests=other.profile.settings.allowGuests})
			local team={}
			for _,id in other.profile.team do
				local slime=other.profile.slimes[id]
				table.insert(team,{uid=id,speciesId=slime.speciesId,evolutionId=slime.evolutionId})
			end
			local selected=if type(other.selected)=="number" then other.nodes[other.selected] else nil
			table.insert(companions,{userId=owner.UserId,team=team,target=if selected then selected.position else nil})
		end
		remote:FireClient(player,{phase="Ready",requestId=requestId,success=errorCode==nil,errorCode=errorCode,
			result=result,sessionNonce=s.nonce,viewRevision=s.viewRevision,profileRevision=s.profile.revision,
			profile=s.profile,location=s.location,slot=s.slot,playing=s.playing,busy=s.busy,
			nodes=if C.islands[s.location] then s.nodes else {},selected=s.selected,
			chances=chances,bases=publicBases,companions=companions,preview=Game.preview(s.profile),serverTime=os.time(),
			event={id=event.id,active=event.active,nextAt=event.nextAt,endsAt=event.endsAt,hp=event.hp,maxHp=event.maxHp,
				cycles=event.cycles[player.UserId] or 0},returning=s.returnAt~=nil})
	end
	local function teleport(player: Player,s: any,location: string,visit: any?)
		s.selected=nil; s.returnAt=nil; s.location=location; s.visit=visit
		local pos=if C.islands[location] then Vector3.new(C.islands[location].x,5,24)
			else Base.origin(if visit then visit.slot else s.slot)+Vector3.new(0,5,22)
		if C.islands[location] then Resources.activate(s,location,integer,C,Game) end
		local part=root(player)
		if part then part.CFrame=CFrame.new(pos); part.AssemblyLinearVelocity=Vector3.zero end
		s.lastPosition=pos; s.lastPositionAt=os.clock(); s.movementAllowed=true
	end
	local function near(player: Player,s: any,coordinates: {number},range: number,los: boolean?): boolean
		local part=root(player)
		local destination=Vector3.new(coordinates[1],coordinates[2],coordinates[3])
		if not part or not s.movementAllowed or (part.Position-destination).Magnitude&gt;range then return false end
		if los then
			local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances=if player.Character then {player.Character} else {}
			if workspace:Raycast(part.Position,destination-part.Position,params) then return false end
		end
		return true
	end
	local function station(player: Player,s: any,kind: string): boolean
		if s.location=="visit" then return false end
		local origin=if s.location=="home" then Base.origin(s.slot) else Vector3.new(C.islands[s.location].x,0,0)
		local offsets={recycler=Vector3.new(-16,4,18),shop=Vector3.new(16,3,18),nursery=Vector3.new(-17,2,-15)}
		local pos=origin+offsets[kind]
		return near(player,s,{pos.X,pos.Y,pos.Z},16)
	end
	local function mutate(player: Player,s: any,action: string,payload: any,id: string)
		if s.busy or s.leaving then send(player,s,"Saving",id); return end
		local fullId=s.nonce..":"..id
		for _,op in s.profile.recentDurableOperations do
			if op.id==fullId then send(player,s,nil,id,op.result); return end
		end
		s.busy=true; s.selected=nil; s.returnAt=nil
		local before=s.profile
		local candidate=Schema.clone(before)
		local ok,result=Game.apply(candidate,action,payload,{now=os.time(),uid=uid(),random=integer,
			randomEnabled=Config.randomOperationsEnabled},C)
		if not ok then s.busy=false; send(player,s,result,id); return end
		candidate.revision+=1; candidate.updatedAt=os.time()
		table.insert(candidate.recentDurableOperations,{id=fullId,result=result})
		if #candidate.recentDurableOperations&gt;128 then table.remove(candidate.recentDurableOperations,1) end
		send(player,s,"Saving",id)
		s.pending={data=candidate,writeId=uid(),action=action,id=id,result=result}
		task.spawn(function()
			local pending=s.pending
			local err: string?=nil
			for attempt=1,5 do
				local saved,reason=store:save(s.handle,pending.data,pending.writeId)
				if saved then
					s.profile=pending.data; s.pending=nil; s.busy=false
					Base.paint(player,s,C)
					Analytics.economy(player,action,s.profile.coins-before.coins,s.profile.coins,Config.analyticsEnabled)
					if action=="ProcessCargo" and before.tutorial.step==4 then Analytics.funnel(player,6,"FirstProcess",Config.analyticsEnabled) end
					if action=="BuyUpgrade" and before.tutorial.step==5 and s.profile.tutorial.step==6 then Analytics.funnel(player,7,"FirstUpgrade",Config.analyticsEnabled) end
					if action=="ViewNursery" and before.tutorial.step==6 then Analytics.funnel(player,8,"TutorialCompleted",Config.analyticsEnabled) end
					if action=="Incubate" or action=="CraftSlime" or action=="EvolveSlime" or action=="UnlockIsland" then Analytics.custom(player,action,Config.analyticsEnabled) end
					if action=="SkipTutorial" then Analytics.custom(player,"TutorialSkipped",Config.analyticsEnabled) end
					send(player,s,nil,id,result); return
				end
				err=reason
				if reason=="LeaseLost" or reason=="RevisionConflict" then break end
				if attempt&lt;5 then task.wait(math.min(8,2^(attempt-1))) end
			end
			-- Unknown write outcome remains frozen. Never roll back and let the user reroll.
				s.blocked=err or "SaveFailed"; send(player,s,s.blocked,id)
				Analytics.custom(player,"SaveFailure",Config.analyticsEnabled)
			if player.Parent then player:Kick("Сохранение недоступно / Save unavailable. Rejoin to recover the last confirmed profile.") end
		end)
	end
	local function join(player: Player)
		if loading[player] or sessions[player] then return end
		loading[player]=true
		task.delay(45,function()
			if loading[player] and player.Parent then player:Kick("Profile loading timed out. Please reconnect; existing data is unchanged.") end
		end)
		remote:FireClient(player,{phase="LoadingProfile"})
		local handle,err=store:load(player.UserId)
		loading[player]=nil
		if not handle then
			if player.Parent then
				remote:FireClient(player,{phase="LoadError",errorCode=err})
				task.delay(5,function() if player.Parent then player:Kick("Профиль не загружен / Profile unavailable. "..tostring(err)) end end)
			end
			return
		end
		local slot=Base.claim(player)
		if not slot or not player.Parent then
			store:save(handle,handle.data,uid(),true)
			if slot then Base.release(slot) end
			if player.Parent then player:Kick("Server full: maximum 8 players") end
			return
		end
		local s: any={owner=player,handle=handle,profile=handle.data,slot=slot,nonce=uid(),ready=false,viewRevision=0,
			location="home",playing=false,busy=false,fields={},nodes={},attackClocks={},hitCounts={},nextUid=uid,
			nextSave=os.clock()+integer(50,70),lastPositionAt=os.clock(),movementAllowed=true,
			limits={},seenTransient={},transientOrder={},playSecond=os.clock()}
		sessions[player]=s
		Base.paint(player,s,C)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart",10)
			if sessions[player]==s then teleport(player,s,s.location,s.visit) end
		end)
		teleport(player,s,"home")
		Analytics.funnel(player,1,"ProfileLoaded",Config.analyticsEnabled)
	end
	local function bucket(s: any,name: string,rate: number,burst: number): boolean
		local now=os.clock(); local b=s.limits[name] or {tokens=burst,at=now}
		b.tokens=math.min(burst,b.tokens+(now-b.at)*rate); b.at=now; s.limits[name]=b
		if b.tokens&lt;1 then return false end; b.tokens-=1; return true
	end
	local stationKinds={ProcessCargo="recycler",BuyUpgrade="shop",LevelSlime="shop",RankSlime="shop",EvolveSlime="shop",
		BuyTea="shop",RollTrait="shop",BuyDecoration="shop",Incubate="nursery",CraftSlime="nursery",ViewNursery="nursery"}
	local transient={Sync=true,Play=true,Pause=true,Modal=true,Travel=true,VisitBase=true,ReturnHome=true,
		SelectTarget=true,SelectEvent=true,CancelTarget=true}
	remote.OnServerEvent:Connect(function(player: Player,r: any)
		if not Protocol.validate(r) then rejectLog(player,"InvalidSchema"); return end
		local s=sessions[player]
		if not s then if r.action=="Sync" then task.spawn(join,player) end; return end
		if not bucket(s,"all",12,20) then rejectLog(player,"RateLimit"); return end
		if r.action=="Sync" then s.ready=true; send(player,s); return end
		if r.sessionNonce~=s.nonce then rejectLog(player,"SessionExpired"); send(player,s,"SessionExpired",r.requestId); return end
		local category=if r.action=="SelectTarget" then "target" elseif transient[r.action] then "ui" else "economy"
		if not bucket(s,category,if category=="target" then 5 elseif category=="ui" then 4 else 2,
			if category=="target" then 10 else 4) then send(player,s,"RateLimit",r.requestId); return end
		if s.busy then send(player,s,"Saving",r.requestId); return end
		if not root(player) then send(player,s,"NotAlive",r.requestId); return end
		local action,v=r.action,r.payload
		if transient[action] then
			if s.seenTransient[r.requestId] then send(player,s,nil,r.requestId); return end
			s.seenTransient[r.requestId]=true; table.insert(s.transientOrder,r.requestId)
			if #s.transientOrder&gt;128 then s.seenTransient[table.remove(s.transientOrder,1)]=nil end
		end
		if action~="ReturnHome" then s.returnAt=nil end
		if action=="Play" then
			s.playing=true; s.modal=false
			if s.profile.tutorial.step&lt;7 and s.location=="home" then teleport(player,s,"shore") end
			Analytics.funnel(player,2,"PlayPressed",Config.analyticsEnabled)
		elseif action=="Pause" then s.playing=false; s.selected=nil
		elseif action=="Modal" then s.modal=v.open; s.selected=nil
		elseif action=="UpdateSettings" then mutate(player,s,action,v,r.requestId); return
		elseif not s.playing then send(player,s,"NotPlaying",r.requestId); return
		elseif action=="Travel" then
			if v.island=="home" then teleport(player,s,"home")
			elseif not C.islands[v.island] or not s.profile.unlockedIslands[v.island] then send(player,s,"LockedIsland",r.requestId); return
			else teleport(player,s,v.island) end
		elseif action=="VisitBase" then
			local guest=sessions[Players:GetPlayerByUserId(v.userId)]
			if not guest or not guest.profile.settings.allowGuests then send(player,s,"GuestsDisabled",r.requestId); return end
			teleport(player,s,"visit",guest)
		elseif action=="ReturnHome" then
			local part=root(player)
			s.selected=nil; s.returnAt=os.clock()+3; s.returnStart=part.Position
		elseif action=="CancelTarget" then s.selected=nil
		elseif action=="SelectTarget" then
			local node=s.nodes[v.nodeId]
			if s.modal or not C.islands[s.location] or not node or node.hp&lt;=0 then send(player,s,"NoTarget",r.requestId); return end
			if not near(player,s,node.position,14,true) then send(player,s,"OutOfRange",r.requestId); return end
			if Game.cargoCount(s.profile)&gt;=C.bag.values[s.profile.equipment.bagTier] then send(player,s,"BagFull",r.requestId); return end
			s.selected=if s.selected==v.nodeId then nil else v.nodeId
			if s.selected then
				if s.profile.tutorial.step==1 then s.profile.tutorial.step=2; Analytics.funnel(player,3,"FirstTarget",Config.analyticsEnabled) end
				for _,id in s.profile.team do s.attackClocks[id]=s.attackClocks[id] or os.clock() end
				s.attackClocks.manual=s.attackClocks.manual or os.clock()
			end
		elseif action=="SelectEvent" then
			if not event.active or s.location~="bay" or s.modal or not near(player,s,{400,5,-50},14,true) then send(player,s,"NoEvent",r.requestId); return end
			s.selected="event"
		elseif s.location=="visit" then send(player,s,"Ownership",r.requestId); return
		else
			local kind=stationKinds[action]
			if kind and not station(player,s,kind) then send(player,s,"StationRange",r.requestId); return end
			if (action=="Incubate" or action=="CraftSlime") and s.location~="home" and v.island~=s.location then send(player,s,"StationRange",r.requestId); return end
			if action=="PlaceDecoration" and (s.location~="home" or v.slot&lt;1 or v.slot&gt;12) then send(player,s,"SlotLocked",r.requestId); return end
			mutate(player,s,action,v,r.requestId); return
		end
		send(player,s,nil,r.requestId)
	end)

	local function leave(player: Player)
		local s=sessions[player]; if not s or s.leaving then return end
		s.leaving=true
		local deadline=os.clock()+20
		while s.busy and not s.blocked and os.clock()&lt;deadline do task.wait(0.1) end
		if not s.busy then
			s.busy=true; s.profile.revision+=1; s.profile.updatedAt=os.time()
			local writeId=uid()
			for attempt=1,3 do
				if store:save(s.handle,s.profile,writeId,true) then break end
				if os.clock()&gt;=deadline then break end
				task.wait(1)
			end
		end
		sessions[player]=nil; rejected[player]=nil; Base.release(s.slot)
	end
	Players.PlayerAdded:Connect(function(player) task.spawn(join,player) end)
	Players.PlayerRemoving:Connect(leave)
	for _,p in Players:GetPlayers() do task.spawn(join,p) end
	game:BindToClose(function()
		for p in sessions do task.spawn(leave,p) end
		local deadline=os.clock()+25
		while next(sessions) and os.clock()&lt;deadline do task.wait(0.1) end
	end)
	local function finishEvent(success: boolean)
		event.active=false
		for p,s in sessions do
			if (event.cycles[p.UserId] or 0)&gt;=10 then event.rewards[p.UserId]={success=success} end
			if s.selected=="event" then s.selected=nil end
		end
	end
	task.spawn(function()
		local lastBroadcast=0
		local lastHeartbeat=0
		while true do
			task.wait(0.1); local now,wall=os.clock(),os.time()
			local broadcast=now-lastBroadcast&gt;=0.3
			local heartbeat=now-lastHeartbeat&gt;=2
			if heartbeat then lastHeartbeat=now end
			if broadcast then lastBroadcast=now end
			if not event.active and wall&gt;=event.nextAt then
				local count=0; for _,s in sessions do if s.profile.unlockedIslands.bay then count+=1 end end
				event={id=uid(),active=true,nextAt=wall+600,endsAt=wall+180,hp=120*math.max(1,count),
					maxHp=120*math.max(1,count),cycles={},last={},rewards={}}
			end
			if event.active and wall&gt;=event.endsAt then finishEvent(false) end
			for p,s in sessions do
				local part=root(p)
				if part then
					local old=s.lastPosition
					if old then
						local delta=Vector3.new(part.Position.X-old.X,0,part.Position.Z-old.Z).Magnitude
						s.movementAllowed=delta&lt;=60*(now-s.lastPositionAt)+4
						if not s.movementAllowed then part.CFrame=CFrame.new(old); s.selected=nil end
					end
					s.lastPosition=part.Position; s.lastPositionAt=now
					if s.returnAt and (part.Position-s.returnStart).Magnitude&gt;2 then s.returnAt=nil end
					if s.returnAt and now&gt;=s.returnAt then teleport(p,s,"home") end
					if part.Position.Y&lt; -25 then teleport(p,s,if C.islands[s.location] then s.location else "home") end
					if s.visit and (not s.visit.profile.settings.allowGuests or sessions[s.visit.owner]~=s.visit) then
						teleport(p,s,"home")
					end
				end
				if wall&gt;=s.handle.expires and not s.busy then s.blocked="LeaseExpired"; s.busy=true; p:Kick("Profile lease expired. Please rejoin.") end
				if not s.busy then
					local oldTutorialStep=s.profile.tutorial.step
					local changed=Resources.tick(s,now,wall,integer,C,Game,function(coords: {number},range: number)
						return near(p,s,coords,range,true)
					end)
					if oldTutorialStep==2 and s.profile.tutorial.step==3 then
						Analytics.funnel(p,4,"ThreeCollected",Config.analyticsEnabled)
						Analytics.funnel(p,5,"SlimeGranted",Config.analyticsEnabled)
					end
					if now-s.playSecond&gt;=1 then
						if s.playing then s.profile.stats.totalPlaySeconds+=math.floor(now-s.playSecond) end
						s.playSecond=now
					end
					if s.selected=="event" and event.active and s.location=="bay" and s.playing and not s.modal
						and near(p,s,{400,5,-50},24,true) then
						local power=0
						local ids=table.clone(s.profile.team)
						if near(p,s,{400,5,-50},14,true) then table.insert(ids,"manual") end
						for _,id in ids do
							local hit,interval=Game.damage(s.profile,if id=="manual" then nil else id,"Metal",wall,C)
							s.attackClocks[id]=s.attackClocks[id] or now
							if now-s.attackClocks[id]&gt;=interval then power+=hit; s.attackClocks[id]=now end
						end
						if power&gt;0 then
							event.cycles[p.UserId]=(event.cycles[p.UserId] or 0)+1
							event.hp=math.max(0,event.hp-math.min(10,power)); changed=true
							if event.hp&lt;=0 then finishEvent(true) end
						end
					end
					local reward=event.rewards[p.UserId]
					if reward then
						event.rewards[p.UserId]=nil; mutate(p,s,"EventReward",reward,"event-"..event.id)
					elseif now&gt;=s.nextSave then
						s.busy=true; s.profile.revision+=1; s.profile.updatedAt=wall
						local candidate=Schema.clone(s.profile); local writeId=uid()
						task.spawn(function()
							local saved,err=false,nil
							for attempt=1,3 do
								saved,err=store:save(s.handle,candidate,writeId)
								if saved or err=="LeaseLost" or err=="RevisionConflict" then break end
								if attempt&lt;3 then task.wait(attempt*2) end
							end
							if saved then s.busy=false; s.nextSave=os.clock()+integer(50,70)
							else s.blocked=err; send(p,s,err); p:Kick("Autosave unavailable. Please rejoin.") end
						end)
					end
					if changed then s.dirty=true end
					if broadcast and (s.dirty or event.active or s.returnAt or heartbeat) then send(p,s); s.dirty=false end
				end
			end
		end
	end)
end
return Server
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX339">
      <Properties>
        <string name="Name">Bootstrap</string>
        <ProtectedString name="Source">--!strict
require(script.Parent:WaitForChild("BetaServer")).start()
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX340">
      <Properties>
        <string name="Name">GameDomain</string>
        <ProtectedString name="Source">--!strict
-- Catalog is injected: this module is executable in standalone Luau tests.
local Game = {}
export type Profile = {[string]: any}
function Game.count(t: {[any]: any}): number
	local n=0; for _ in t do n+=1 end; return n
end
function Game.cargoCount(p: Profile): number
	local n=0; for _,g in p.cargo do n+=g.count end; return n
end
function Game.slots(p: Profile): number
	return if p.unlockedIslands.bay then 3 elseif p.tutorial.step&gt;=7 then 2 else 1
end
function Game.highest(p: Profile): string
	local unlocked: any=p.unlockedIslands
	return if unlocked.cave then "cave" elseif unlocked.bay then "bay" else "shore"
end
function Game.weights(p: Profile, island: string, c: any): {number}
	local pity=p.incubators[island]
	local first=if pity.sinceLegendary&gt;=199 then 5 elseif pity.sinceEpic&gt;=49 then 4 elseif pity.sinceRare&gt;=9 then 3 else 1
	local weights={}
	for i,w in c.slimeWeights do weights[i]=if i&gt;=first then w else 0 end
	return weights
end
function Game.roll(weights: {number}, random: (number,number)-&gt;number): number
	local total=0; for _,w in weights do total+=w end
	local result=random(1,total)
	for index,w in weights do result-=w; if result&lt;=0 then return index end end
	error("Invalid random result")
end
local function spend(p: Profile, price: number): boolean
	if p.coins&lt;price then return false end
	p.coins-=price; return true
end
local function grantSlime(p: Profile, species: string, uid: string)
	p.slimes[uid]={speciesId=species,level=1,rank=0,locked=false}
	p.collections.slimeSpeciesIds[species]=true
end
function Game.starter(p: Profile, uid: string)
	local rewards=p.tutorial.grantedRewardIds
	if not rewards.starter then
		grantSlime(p,"shore_sprout",uid)
		p.starterUid=uid
		table.insert(p.team,uid)
		rewards.starter=true
	end
end
function Game.collect(p: Profile, node: any, helperWorked: boolean, uid: string, c: any): (boolean,string?)
	if Game.cargoCount(p)&gt;=c.bag.values[p.equipment.bagTier] then return false,"BagFull" end
	local key=node.island.."/"..node.material.."/"..tostring(node.rarity)
	local g=p.cargo[key]
	if not g then
		g={island=node.island,material=node.material,count=0,coinValueEach=node.coins,
			materialAmountEach=node.amount,balanceVersion=c.balanceVersion}
		p.cargo[key]=g
	end
	g.count+=1
	local collection=node.island.."/"..tostring(node.family).."/"..tostring(node.rarity)
	p.collections.junkCountsByKey[collection]=(p.collections.junkCountsByKey[collection] or 0)+1
	if p.tutorial.step==2 and node.rarity==1 then
		p.tutorial.counters.collected+=1
		if p.tutorial.counters.collected&gt;=3 then Game.starter(p,uid); p.tutorial.step=3 end
	elseif p.tutorial.step==3 and helperWorked then p.tutorial.step=4 end
	return true,nil
end
function Game.preview(p: Profile): any
	local result={coins=0,materials={Plastic=0,Metal=0,Crystal=0},islands={shore=0,bay=0,cave=0}}
	for _,g in p.cargo do
		result.coins+=g.count*g.coinValueEach
		result.materials[g.material]+=g.count*g.materialAmountEach
		result.islands[g.island]+=g.count
	end
	return result
end
function Game.damage(p: Profile, uid: string?, material: string, now: number, c: any): (number,number,string)
	local tea=if p.tutorial.step&gt;=7 and p.boosts.workTeaExpiresAt&gt;now then 0.1 else 0
	local trait=p.equipment.toolTrait
	local power=c.tool.values[p.equipment.toolTier]
	local rate,role,interval=tea,"Manual",0.8
	if uid then
		local slime=p.slimes[uid]
		local species=c.species[slime.speciesId]
		role=species.role
		if slime.evolutionId then role=c.evolutions[slime.speciesId].role end
		trait=slime.traitId
		power=c.islands[species.island].power*c.rarityPower[species.rarity]
			*(1+0.12*(slime.level-1))*(1+0.1*slime.rank)*(if slime.evolutionId then 1.2 else 1)
		interval=1.2
		for _,teamUid in p.team do
			local mate=p.slimes[teamUid]
			if c.species[mate.speciesId].role=="Support" then rate+=0.05; break end
		end
		if role=="Support" then power*=0.9 end
		if role=="Breaker" and material=="Metal" then power*=1.35 end
	end
	if trait=="nimble" then rate+=0.05 end
	if trait=="sturdy" then power*=1.05
	elseif (trait=="metalwork" and material=="Metal") or (trait=="crystalwork" and material=="Crystal") then power*=1.08 end
	return power,interval/(1+math.min(0.2,rate)),role
end

-- Applies to an isolated candidate profile. Returning false means discard the entire candidate.
function Game.apply(p: Profile, action: string, v: any, context: any, c: any): (boolean,any)
	local now=context.now
	if action=="SkipTutorial" then
		if p.tutorial.step&gt;=7 then return true,{} end
		if not p.tutorial.grantedRewardIds.bonus and p.coins&gt;c.coinLimit-15 then return false,"Limit" end
		Game.starter(p,context.uid)
		if not p.tutorial.grantedRewardIds.bonus then p.coins+=15; p.tutorial.grantedRewardIds.bonus=true end
		p.tutorial.state="Skipped"; p.tutorial.step=7
	elseif action=="ProcessCargo" then
		if Game.cargoCount(p)==0 then return false,"EmptyBag" end
		local reward=Game.preview(p)
		local bonus=if p.tutorial.step==4 and not p.tutorial.grantedRewardIds.bonus then 15 else 0
		if p.coins+reward.coins+bonus&gt;c.coinLimit then return false,"Limit" end
		for material,n in reward.materials do if p.materials[material]+n&gt;c.itemLimit then return false,"Limit" end end
		for island,n in reward.islands do
			if p.fragments[island]+math.floor((p.fragmentProgress[island]+n)/15)&gt;c.itemLimit then return false,"Limit" end
		end
		p.coins+=reward.coins+bonus
		for material,n in reward.materials do p.materials[material]+=n end
		for island,n in reward.islands do
			p.fragments[island]+=math.floor((p.fragmentProgress[island]+n)/15)
			p.fragmentProgress[island]=(p.fragmentProgress[island]+n)%15
		end
		p.stats.totalProcessed+=Game.cargoCount(p); p.cargo={}
		for tier,threshold in c.restoration do if p.stats.totalProcessed&gt;=threshold then p.base.restorationTier=tier end end
		if p.tutorial.step==4 then
			p.tutorial.grantedRewardIds.bonus=true
			p.tutorial.step=if p.equipment.toolTier&gt;=2 then 6 else 5
		end
	elseif action=="BuyUpgrade" then
		local kind=v.kind; local catalog=c[kind]
		if not table.find({"tool","bag","storage"},kind) then return false,"UnknownId" end
		local key=kind.."Tier"; local tier=p.equipment[key]
		if tier~=v.expectedTier then return false,"StaleState" end
		local price=catalog.prices[tier+1]
		if not price then return false,"MaxTier" end
		if c.islands[Game.highest(p)].index&lt;catalog.access[tier+1] then return false,"LockedIsland" end
		if not spend(p,price) then return false,"NotEnoughCoins" end
		p.equipment[key]=tier+1
		if kind=="tool" and p.tutorial.step==5 then p.tutorial.step=6 end
	elseif action=="ViewNursery" then
		if p.tutorial.step==6 then p.tutorial.step=7; p.tutorial.state="Completed" end
	elseif action=="UnlockIsland" then
		local island=c.islands[v.island]
		if not island then return false,"UnknownId" end
		if p.unlockedIslands[v.island] then return true,{} end
		if not p.unlockedIslands[c.order[island.index-1]] then return false,"LockedIsland" end
		if not spend(p,island.price) then return false,"NotEnoughCoins" end
		p.unlockedIslands[v.island]=true
	elseif action=="EquipTeam" then
		if #v.uids&gt;Game.slots(p) then return false,"TeamLimit" end
		local used={}
		for _,uid in v.uids do if not p.slimes[uid] or used[uid] then return false,"Ownership" end; used[uid]=true end
		p.team=table.clone(v.uids)
	elseif action=="LockSlime" then
		if not p.slimes[v.uid] then return false,"Ownership" end
		p.slimes[v.uid].locked=v.locked
	elseif action=="LevelSlime" or action=="RankSlime" or action=="EvolveSlime" then
		local slime=p.slimes[v.uid]
		if not slime then return false,"Ownership" end
		local offer: any=p.pendingTraitOffer
		if action=="EvolveSlime" and offer and offer.target==v.uid then return false,"PendingOffer" end
		local species=c.species[slime.speciesId]; local island=c.islands[species.island]
		if action=="LevelSlime" then
			if slime.level~=v.expectedLevel then return false,"StaleState" end
			if slime.level&gt;=10 then return false,"MaxTier" end
			if not spend(p,math.ceil(20*island.factor*slime.level^1.7)) then return false,"NotEnoughCoins" end
			slime.level+=1
		elseif action=="RankSlime" then
			if slime.rank~=v.expectedRank then return false,"StaleState" end
			if slime.rank&gt;=3 then return false,"MaxTier" end
			local price=c.rankPrices[slime.rank+1]*c.rankFactors[species.rarity]
			if p.fragments[species.island]&lt;price then return false,"NotEnoughFragments" end
			p.fragments[species.island]-=price; slime.rank+=1
		else
			local recipe=c.evolutions[slime.speciesId]
			if not recipe or recipe.id~=v.recipeId or slime.evolutionId or slime.level&lt;3 then return false,"Recipe" end
			if not p.unlockedIslands[recipe.island] then return false,"LockedIsland" end
			if p.materials[recipe.material]&lt;recipe.amount then return false,"NotEnoughMaterials" end
			if not spend(p,recipe.coins) then return false,"NotEnoughCoins" end
			p.materials[recipe.material]-=recipe.amount; slime.evolutionId=recipe.id
			p.collections.evolutions[recipe.id]=true
		end
	elseif action=="Incubate" or action=="CraftSlime" then
		if not c.islands[v.island] or not p.unlockedIslands[v.island] then return false,"LockedIsland" end
		if Game.count(p.slimes)&gt;=c.storage.values[p.equipment.storageTier] then return false,"StorageFull" end
		local species: string
		if action=="CraftSlime" then
			local item=c.species[v.speciesId]
			if not item or item.island~=v.island then return false,"UnknownId" end
			local price=c.craft[item.rarity]
			if p.fragments[v.island]&lt;price then return false,"NotEnoughFragments" end
			p.fragments[v.island]-=price; species=item.id
		else
			if not context.randomEnabled then return false,"FeatureDisabled" end
			if not spend(p,c.islands[v.island].incubation) then return false,"NotEnoughCoins" end
			local rarity=Game.roll(Game.weights(p,v.island,c),context.random)
			species=c.sets[v.island][rarity]
			local pity=p.incubators[v.island]
			pity.sinceRare=if rarity&gt;=3 then 0 else pity.sinceRare+1
			pity.sinceEpic=if rarity&gt;=4 then 0 else pity.sinceEpic+1
			pity.sinceLegendary=if rarity&gt;=5 then 0 else pity.sinceLegendary+1
		end
		grantSlime(p,species,context.uid)
		return true,{uid=context.uid,speciesId=species}
	elseif action=="RecycleSlimes" then
		if #v.uids&lt;1 or #v.uids&gt;20 or Game.count(p.slimes)-#v.uids&lt;1 then return false,"ProtectedSlime" end
		local seen,awards={}, {shore=0,bay=0,cave=0}
		for _,uid in v.uids do
			local s=p.slimes[uid]
			if not s or seen[uid] or s.locked or uid==p.starterUid or table.find(p.team,uid)
				or (p.pendingTraitOffer and p.pendingTraitOffer.target==uid) then return false,"ProtectedSlime" end
			seen[uid]=true; local species=c.species[s.speciesId]
			awards[species.island]+=c.recycle[species.rarity]
		end
		for island,n in awards do if p.fragments[island]+n&gt;c.itemLimit then return false,"Limit" end end
		for island,n in awards do p.fragments[island]+=n end
		for _,uid in v.uids do p.slimes[uid]=nil end
	elseif action=="BuyTea" then
		if p.tutorial.step&lt;7 then return false,"TutorialFirst" end
		local remaining=math.max(0,p.boosts.workTeaExpiresAt-now)
		if remaining+300&gt;900 then return false,"TeaLimit" end
		if not spend(p,c.islands[Game.highest(p)].tea) then return false,"NotEnoughCoins" end
		p.boosts.workTeaExpiresAt=now+remaining+300
	elseif action=="RollTrait" then
		if not context.randomEnabled then return false,"FeatureDisabled" end
		if not p.unlockedIslands.bay then return false,"LockedIsland" end
		if p.pendingTraitOffer then return false,"PendingOffer" end
		local origin=Game.highest(p)
		if v.target=="tool" then if p.equipment.toolTier&lt;3 then return false,"LevelRequired" end
		else
			local s=p.slimes[v.target]; if not s then return false,"Ownership" end
			if s.level&lt;3 then return false,"LevelRequired" end
			origin=c.species[s.speciesId].island
		end
		if not spend(p,c.islands[origin].trait) then return false,"NotEnoughCoins" end
		p.pendingTraitOffer={id=context.uid,target=v.target,traitId=c.traits[Game.roll(c.traitWeights,context.random)]}
		return true,p.pendingTraitOffer
	elseif action=="ResolveTrait" then
		local offer=p.pendingTraitOffer
		if not offer or offer.id~=v.offerId then return false,"StaleState" end
		if v.accept then
			if offer.target=="tool" then p.equipment.toolTrait=offer.traitId
			else p.slimes[offer.target].traitId=offer.traitId end
		end
		p.pendingTraitOffer=nil
	elseif action=="BuyDecoration" then
		local item=c.decor[v.itemId]
		if not item then return false,"UnknownId" end
		if p.base.ownedDecor[v.itemId] then return true,{} end
		if not p.unlockedIslands[item.island] then return false,"LockedIsland" end
		if not spend(p,item.price) then return false,"NotEnoughCoins" end
		p.base.ownedDecor[v.itemId]=true
	elseif action=="PlaceDecoration" then
		if v.slot&gt;p.base.restorationTier*3 then return false,"SlotLocked" end
		if v.itemId~="" and not p.base.ownedDecor[v.itemId] then return false,"Ownership" end
		p.base.decorationSlots[tostring(v.slot)]=if v.itemId=="" then nil else v.itemId
	elseif action=="UpdateSettings" then
		for key,value in v do
			if type(p.settings[key])~=type(value) then return false,"InvalidSetting" end
			if key=="language" and value~="ru" and value~="en" then return false,"InvalidSetting" end
			p.settings[key]=value
		end
	elseif action=="EventReward" then
		if now-p.lastEventRewardAt&lt;600 then return false,"RewardCooldown" end
		local coins=if v.success then 100 else 20
		local fragments=if v.success then 2 else 1
		if p.coins+coins&gt;c.coinLimit or p.fragments.bay+fragments&gt;c.itemLimit then return false,"Limit" end
		p.coins+=coins; p.fragments.bay+=fragments; p.lastEventRewardAt=now
	else return false,"UnknownAction" end
	return true,{}
end
return Game
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX341">
      <Properties>
        <string name="Name">Lease</string>
        <ProtectedString name="Source">--!strict
local Lease={}
function Lease.acquire(old: any,token: string,now: number,newProfile: ()-&gt;any,validate: (any)-&gt;(boolean,string?)): (any,string?)
	if old==nil then old={data=newProfile()} end
	if type(old)~="table" or type(old.data)~="table" then return nil,"ProfileShape" end
	local valid,err=validate(old.data)
	if not valid then return nil,err end
	if old.lease and (type(old.lease)~="table" or type(old.lease.expires)~="number") then return nil,"LeaseShape" end
	if old.lease and old.lease.token~=token and old.lease.expires&gt;now then return nil,"ProfileLocked" end
	return {data=old.data,lease={token=token,expires=now+180},commitId=old.commitId},nil
end
function Lease.write(old: any,token: string,expected: number,candidate: any,writeId: string,release: boolean?,now: number): (any,string?)
	if not old or not old.lease or old.lease.token~=token or old.lease.expires&lt;=now then return nil,"LeaseLost" end
	if old.commitId~=writeId and old.data.revision~=expected then return nil,"RevisionConflict" end
	return {data=candidate,commitId=writeId,lease=if release then nil else {token=token,expires=now+180}},nil
end
return Lease
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX342">
      <Properties>
        <string name="Name">ProfileSchema</string>
        <ProtectedString name="Source">--!strict
-- Reject malformed or future data; never replace an unrecognised profile with defaults.
local Schema = {}
export type Profile = {[string]: any}
function Schema.clone(value: any): any
	if type(value) ~= "table" then return value end
	local copy = {}
	for k, v in value do copy[k] = Schema.clone(v) end
	return copy
end
function Schema.new(now: number, catalog: any): Profile
	local p: Profile = {
		schemaVersion=1, revision=0, balanceVersion=catalog.balanceVersion, createdAt=now, updatedAt=now,
		coins=0, materials={Plastic=0,Metal=0,Crystal=0}, fragments={shore=0,bay=0,cave=0}, cargo={},
		equipment={toolTier=1,bagTier=1,storageTier=1}, slimes={}, team={}, unlockedIslands={shore=true},
		base={restorationTier=1,decorationSlots={},ownedDecor={}},
		tutorial={version=1,state="Active",step=1,counters={collected=0},grantedRewardIds={}},
		collections={slimeSpeciesIds={},junkCountsByKey={},evolutions={}},
		incubators={}, fragmentProgress={shore=0,bay=0,cave=0}, recentDurableOperations={}, lastEventRewardAt=0,
		settings={language="ru",music=true,sound=true,lowEffects=false,reducedMotion=false,autoRepeat=false,allowGuests=false},
		boosts={workTeaExpiresAt=0}, stats={totalProcessed=0,totalPlaySeconds=0}, cosmeticEntitlements={},
	}
	for _, id in catalog.order do p.incubators[id]={sinceRare=0,sinceEpic=0,sinceLegendary=0} end
	return p
end
local function integer(n: any, limit: number): boolean
	return type(n)=="number" and n==n and n&gt;=0 and n&lt;=limit and n%1==0
end
function Schema.validate(p: any, c: any): (boolean, string?)
	if type(p)~="table" or p.schemaVersion~=c.schemaVersion then return false,"SchemaVersion" end
	-- Enforce required shape before checking references or arithmetic.
	local sample = Schema.new(0,c)
	local function shape(value: any, template: any): boolean
		if type(value)~=type(template) then return false end
		if type(template)~="table" then return true end
		for key, expected in template do if not shape(value[key],expected) then return false end end
		return true
	end
	if not shape(p,sample) then return false,"ProfileShape" end
	if not integer(p.coins,c.coinLimit) or not integer(p.revision,1e15) then return false,"Wallet" end
	for _, material in c.materials do if not integer(p.materials[material],c.itemLimit) then return false,"Material" end end
	for _, id in c.order do
		if not integer(p.fragments[id],c.itemLimit) or not integer(p.fragmentProgress[id],14) then return false,"Fragments" end
		for _, key in {"sinceRare","sinceEpic","sinceLegendary"} do
			if not integer(p.incubators[id][key],1000000000) then return false,"Pity" end
		end
	end
	for _, key in {"tool","bag","storage"} do
		local tier = p.equipment[key.."Tier"]
		if not integer(tier,#c[key].values) or tier&lt;1 then return false,"Equipment" end
	end
	local count=0
	for uid, slime in p.slimes do
		count+=1
		if type(uid)~="string" or #uid&gt;64 or type(slime)~="table" or not c.species[slime.speciesId]
			or not integer(slime.level,10) or slime.level&lt;1 or not integer(slime.rank,3)
			or type(slime.locked)~="boolean" then return false,"Slime" end
		if slime.evolutionId then
			local evo = c.evolutions[slime.speciesId]
			if not evo or evo.id~=slime.evolutionId then return false,"Evolution" end
		end
		if slime.traitId and not table.find(c.traits,slime.traitId) then return false,"Trait" end
	end
	if count&gt;100 then return false,"Storage" end
	local seen={}
	local slots=if p.unlockedIslands.bay then 3 elseif p.tutorial.step&gt;=7 then 2 else 1
	if #p.team&gt;slots then return false,"Team" end
	for _, uid in p.team do
		if not p.slimes[uid] or seen[uid] then return false,"Team" end
		seen[uid]=true
	end
	local cargoCount, groups=0,0
	for key, g in p.cargo do
		groups+=1
		if type(key)~="string" or type(g)~="table" or not c.islands[g.island]
			or not table.find(c.materials,g.material) or not integer(g.count,72)
			or not integer(g.coinValueEach,100000) or not integer(g.materialAmountEach,100)
			or type(g.balanceVersion)~="string" then return false,"Cargo" end
		cargoCount+=g.count
	end
	if groups&gt;45 or cargoCount&gt;c.bag.values[p.equipment.bagTier] then return false,"CargoSize" end
	if #p.recentDurableOperations&gt;128 then return false,"Operations" end
	for _, op in p.recentDurableOperations do
		if type(op)~="table" or type(op.id)~="string" or #op.id&gt;130 then return false,"Operation" end
	end
	if not p.unlockedIslands.shore or (p.unlockedIslands.cave and not p.unlockedIslands.bay) then return false,"Islands" end
	for id in p.unlockedIslands do if not c.islands[id] then return false,"Island" end end
	if not integer(p.tutorial.step,7) or p.tutorial.step&lt;1 then return false,"Tutorial" end
	if not table.find({"Active","Completed","Skipped"},p.tutorial.state) then return false,"Tutorial" end
	if not integer(p.base.restorationTier,4) or p.base.restorationTier&lt;1 then return false,"Base" end
	for slot, id in p.base.decorationSlots do
		local slotNumber=tonumber(slot)
		if type(slot)~="string" or not slotNumber or not integer(slotNumber,12) or slotNumber&lt;1
			or slot~=tostring(slotNumber)
			or not c.decor[id] or not p.base.ownedDecor[id] then return false,"Decoration" end
	end
	if not integer(p.stats.totalProcessed,1e12) or not integer(p.stats.totalPlaySeconds,1e12)
		or not integer(p.boosts.workTeaExpiresAt,1e12) or not integer(p.lastEventRewardAt,1e12) then return false,"Counters" end
	if p.settings.language~="ru" and p.settings.language~="en" then return false,"Language" end
	for key, default in sample.settings do if type(p.settings[key])~=type(default) then return false,"Setting" end end
	if p.pendingTraitOffer then
		local o=p.pendingTraitOffer
		if type(o)~="table" or type(o.id)~="string" or not table.find(c.traits,o.traitId)
			or (o.target~="tool" and not p.slimes[o.target]) then return false,"Offer" end
	end
	return true,nil
end
return Schema
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX343">
      <Properties>
        <string name="Name">ProfileStore</string>
        <ProtectedString name="Source">--!strict
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local Schema=require(script.Parent:WaitForChild("ProfileSchema"))
local Lease=require(script.Parent:WaitForChild("Lease"))
local Store={}
Store.__index=Store
function Store.new(config: any,catalog: any): any
	assert(table.find({"Test","Beta","Production"},config.environment),"Invalid environment")
	assert(not (RunService:IsStudio() and config.environment=="Production"),"Studio may not write Production")
	return setmetatable({catalog=catalog,ds=DataStoreService:GetDataStore("SlimeSalvage_"..config.environment.."_v1")},Store)
end

function Store.load(self: any,userId: number): (any,string?)
	local token=HttpService:GenerateGUID(false)
	local start=os.clock()
	for attempt=1,5 do
		local reason="LoadFailed"
		local ok,record=pcall(function()
			return self.ds:UpdateAsync("u_"..tostring(userId),function(old: any)
				local now=os.time()
				local result,err=Lease.acquire(old,token,now,function() return Schema.new(now,self.catalog) end,
					function(data: any) return Schema.validate(data,self.catalog) end)
				if not result then reason=err end
				return result
			end)
		end)
		if ok and record and record.lease and record.lease.token==token then
			return {key="u_"..tostring(userId),token=token,expires=record.lease.expires,
				data=record.data,savedRevision=record.data.revision,lastCommit=record.commitId},nil
		end
		if ok and reason~="ProfileLocked" and reason~="LoadFailed" then return nil,reason end
		if os.clock()-start&gt;=40 then break end
		if attempt&lt;5 then task.wait(math.min(8,2^(attempt-1))+math.random()) end
	end
	return nil,"LoadFailed"
end

function Store.save(self: any,handle: any,candidate: any,writeId: string,release: boolean?): (boolean,string?)
	local valid,err=Schema.validate(candidate,self.catalog)
	if not valid then return false,err end
	local encodedOk,encoded=pcall(function() return HttpService:JSONEncode(candidate) end)
	if not encodedOk or #encoded&gt;200000 then return false,"ProfileSize" end
	local expected=handle.savedRevision
	local reason="SaveFailed"
	local ok,record=pcall(function()
		return self.ds:UpdateAsync(handle.key,function(old: any)
			-- A previous response can be lost after a successful write. Confirm the same write,
			-- never roll a new result or overwrite a newer revision during a retry.
			local result,err=Lease.write(old,handle.token,expected,candidate,writeId,release,os.time())
			if not result then reason=err end
			return result
		end)
	end)
	if not ok or not record or record.commitId~=writeId then return false,reason end
	handle.savedRevision=candidate.revision
	handle.expires=if release then 0 else record.lease.expires
	handle.data=candidate
	return true,nil
end
return Store
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX344">
      <Properties>
        <string name="Name">ResourceService</string>
        <ProtectedString name="Source">--!strict
local R={}
local function distance(a: {number},b: {number}): number
	return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)
end
function R.positions(island: string,c: any): {{number}}
	local result={}
	for row=0,5 do for col=0,5 do
		local x=if col&lt;3 then -25+col*8 else 9+(col-3)*8
		table.insert(result,{c.islands[island].x+x,2.8,-25+row*6})
	end end
	return result
end
function R.node(id: number,island: string,p: any,nodes: {any},random: any,c: any,g: any): any
	local simple=0
	for _,n in nodes do if n.hp&gt;0 and n.rarity&lt;=2 then simple+=1 end end
	local rarity=g.roll(c.junkWeights,random)
	if simple&lt;12 or (island=="shore" and p.tutorial.step&lt;=3) then rarity=1 end
	local material=c.materials[g.roll(c.islands[island].materials,random)]
	local hp=math.ceil(c.islands[island].hp*c.hpMultipliers[rarity])
	return {id=id,island=island,rarity=rarity,material=material,
		family=table.find(c.materials,material),hp=hp,maxHp=hp,
		coins=math.floor(c.islands[island].coins*c.coinMultipliers[rarity]),amount=c.amounts[rarity],
		position=R.positions(island,c)[id],helperWorked=false,state="Idle",readyAt=0}
end
function R.activate(s: any,island: string,random: any,c: any,g: any)
	s.fields=s.fields or {}
	if not s.fields[island] then
		local nodes={}; for id=1,36 do nodes[id]=R.node(id,island,s.profile,nodes,random,c,g) end
		s.fields[island]=nodes
	end
	s.nodes=s.fields[island]; s.selected=nil; s.attackClocks=s.attackClocks or {}; s.hitCounts=s.hitCounts or {}
end
function R.tick(s: any,now: number,wall: number,random: any,c: any,g: any,canHit: any): boolean
	if not c.islands[s.location] then return false end
	local changed=false
	for id,node in s.nodes do
		if node.hp&lt;=0 and now&gt;=node.readyAt then
			s.nodes[id]=R.node(id,s.location,s.profile,s.nodes,random,c,g); changed=true
		end
	end
	if not s.playing or s.modal or s.busy then return changed end
	local node=if type(s.selected)=="number" then s.nodes[s.selected] else nil
	if not node or node.hp&lt;=0 then return changed end
	if g.cargoCount(s.profile)&gt;=c.bag.values[s.profile.equipment.bagTier] then s.selected=nil; return true end
	if not canHit(node.position,24) then
		s.outsideSince=s.outsideSince or now
		if now-s.outsideSince&gt;1 then s.selected=nil; return true end
		return changed
	end
	s.outsideSince=nil
	node.state="Working"
	local function hit(target: any,power: number,helper: boolean)
		if target.hp&lt;=0 or g.cargoCount(s.profile)&gt;=c.bag.values[s.profile.equipment.bagTier] then return end
		target.hp=math.max(0,target.hp-power); target.helperWorked=target.helperWorked or helper; changed=true
		if target.hp&lt;=0 then
			local ok=g.collect(s.profile,target,target.helperWorked,s.nextUid(),c)
			assert(ok,"Capacity checked before damage")
			target.state="RespawnCooldown"; target.readyAt=now+random(8,12)
		end
	end
	for _,uid in s.profile.team do
		if node.hp&lt;=0 then break end
		local power,interval,role=g.damage(s.profile,uid,node.material,wall,c)
		if not s.attackClocks[uid] then s.attackClocks[uid]=now end
		local last=s.attackClocks[uid]
		if now-last&gt;=interval then
			s.attackClocks[uid]=now; s.hitCounts[uid]=(s.hitCounts[uid] or 0)+1
			hit(node,power,true)
			if role=="Sweeper" and s.hitCounts[uid]%5==0 then
				local closest,range=nil,6.001
				for _,other in s.nodes do
					local d=distance(node.position,other.position)
					if other~=node and other.hp&gt;0 and d&lt;range then closest=other; range=d end
				end
				if closest then hit(closest,power*0.3,true) end
			end
		end
	end
	if node.hp&gt;0 and canHit(node.position,14) then
		if not s.attackClocks.manual then s.attackClocks.manual=now end
		local power,interval=g.damage(s.profile,nil,node.material,wall,c)
		if now-(s.attackClocks.manual or now)&gt;=interval then s.attackClocks.manual=now; hit(node,power,false) end
	end
	if node.hp&lt;=0 then
		s.selected=nil
		if s.profile.settings.autoRepeat and s.profile.tutorial.step&gt;=7 then
			for _,candidate in s.nodes do
				if candidate.hp&gt;0 and canHit(candidate.position,14) then s.selected=candidate.id; break end
			end
		end
	end
	return changed
end
return R
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX330">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX331">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX345">
        <Properties>
          <string name="Name">AudioController</string>
          <ProtectedString name="Source">--!strict
local SoundService=game:GetService("SoundService")
local A={}
function A.start(config: any): any
	local music=Instance.new("Sound"); music.Name="SlimeMusic"; music.Looped=true; music.Volume=0.15; music.Parent=SoundService
	local effect=Instance.new("Sound"); effect.Name="SlimeEffect"; effect.Volume=0.25; effect.Parent=SoundService
	if config.audio.music~="" then music.SoundId=config.audio.music end
	local settings: any={music=false,sound=false}
	local previous=0
	return {
		settings=function(value: any)
			settings=value
			if settings.music and music.SoundId~="" then if not music.IsPlaying then music:Play() end else music:Pause() end
		end,
		play=function(kind: string)
			if not settings.sound or os.clock()-previous&lt;0.15 or config.audio[kind]=="" then return end
			previous=os.clock(); effect.SoundId=config.audio[kind]; effect:Play()
		end,
	}
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX346">
        <Properties>
          <string name="Name">BetaClient</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Input=game:GetService("UserInputService")
local Http=game:GetService("HttpService")
local shared=ReplicatedStorage:WaitForChild("Shared")
local C=require(shared:WaitForChild("Catalog"))
local text=require(shared:WaitForChild("Strings"))
local Renderer=require(script.Parent:WaitForChild("BetaRenderer"))
local Config=require(shared:WaitForChild("BuildConfig"))
local Audio=require(script.Parent:WaitForChild("AudioController"))
local Client={}
function Client.start()
	local player=Players.LocalPlayer
	local remote=ReplicatedStorage:WaitForChild("BetaSession") :: RemoteEvent
	local renderer=Renderer.start()
	local audio=Audio.start(Config)
	local lastCargo=0
	local state: any=nil
	local lang="ru"
	local currentPanel=""
	local tab="tool"
	local selectedIsland="shore"
	local chosenDecor="planter"
	local selectedSlime: string?=nil
	local recycleSelection: {[string]: boolean}={}
	local pending: any=nil
	local lastView=0
	local panelRevision=-1
	local lastGoal=0
	local goalChangedAt=os.clock()
	local goalStation: string?=nil
	local function t(key: string): string return text(key,lang) end
	local function named(item: any): string return item[lang] or item.en end
	local gui=Instance.new("ScreenGui"); gui.Name="SlimeSalvage"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false
	gui.Parent=player:WaitForChild("PlayerGui")
	local hud=Instance.new("TextLabel"); hud.Size=UDim2.new(1,-24,0,90); hud.Position=UDim2.fromOffset(12,8)
	hud.BackgroundColor3=Color3.fromRGB(25,48,51); hud.TextColor3=Color3.fromRGB(241,241,216)
	hud.TextSize=15; hud.TextWrapped=true; hud.Font=Enum.Font.GothamMedium; hud.Text=t("connecting"); hud.Parent=gui
	local toast=hud:Clone(); toast.Name="Message"; toast.Size=UDim2.new(1,-24,0,48); toast.Position=UDim2.fromOffset(12,154)
	toast.Visible=false; toast.ZIndex=20; toast.Parent=gui
	local function notify(message: string)
		toast.Text=message; toast.Visible=true
		local captured=message
		task.delay(5,function() if toast.Text==captured then toast.Visible=false end end)
	end
	local function request(action: string,payload: any?)
		if action~="Sync" and not state then return end
		if state and state.busy and action~="Sync" then notify(t("saving")); return end
		local r={protocolVersion=2,requestId=Http:GenerateGUID(false),action=action,payload=payload or {},
			sessionNonce=if state then state.sessionNonce else nil}
		local transient={Sync=true,Play=true,Pause=true,Modal=true,Travel=true,VisitBase=true,ReturnHome=true,SelectTarget=true,SelectEvent=true,CancelTarget=true}
		if not transient[action] then
			if pending then notify(t("saving")); return end
			pending={request=r,sentAt=os.clock()}
		end
		remote:FireServer(r)
	end
	local function frame(parent: Instance,size: UDim2,position: UDim2): Frame
		local f=Instance.new("Frame"); f.Size=size; f.Position=position; f.BackgroundColor3=Color3.fromRGB(35,61,64); f.Parent=parent
		local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,10); corner.Parent=f; return f
	end
	local function button(parent: Instance,title: string,callback: ()-&gt;(),enabled: boolean?): TextButton
		local b=Instance.new("TextButton"); b.Size=UDim2.new(1,-12,0,46); b.Text=title
		b.BackgroundColor3=if enabled==false then Color3.fromRGB(104,121,119) else Color3.fromRGB(164,213,146)
		b.TextColor3=Color3.fromRGB(25,46,42); b.Font=Enum.Font.GothamMedium; b.TextSize=15; b.TextWrapped=true
		b.AutoButtonColor=enabled~=false; b.Active=enabled~=false; b.Parent=parent
		if enabled~=false then b.Activated:Connect(callback) end
		local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,7); corner.Parent=b; return b
	end
	local function label(parent: Instance,value: string): TextLabel
		local l=Instance.new("TextLabel"); l.Size=UDim2.new(1,-12,0,44); l.AutomaticSize=Enum.AutomaticSize.Y
		l.Text=value; l.TextColor3=Color3.fromRGB(236,238,219); l.BackgroundTransparency=1
		l.Font=Enum.Font.Gotham; l.TextSize=16; l.TextWrapped=true; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=parent; return l
	end
	local function vertical(parent: Instance)
		local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,7); layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Parent=parent
		local pad=Instance.new("UIPadding"); pad.PaddingTop=UDim.new(0,8); pad.PaddingLeft=UDim.new(0,8); pad.PaddingBottom=UDim.new(0,12); pad.Parent=parent
	end
	local menu=frame(gui,UDim2.fromOffset(280,180),UDim2.new(0.5,-140,0.5,-70)); vertical(menu)
	menu.Visible=false
	local panel=frame(gui,UDim2.new(0.92,0,0.66,0),UDim2.fromScale(0.04,0.32)); panel.Visible=false; panel.ZIndex=5
	local panelTitle=label(panel,""); panelTitle.Size=UDim2.new(1,-140,0,44); panelTitle.Position=UDim2.fromOffset(12,0)
	local content=Instance.new("ScrollingFrame"); content.Size=UDim2.new(1,-16,1,-64); content.Position=UDim2.fromOffset(8,56)
	content.BackgroundTransparency=1; content.ScrollBarThickness=6; content.CanvasSize=UDim2.new(); content.AutomaticCanvasSize=Enum.AutomaticSize.Y
	content.ScrollingDirection=Enum.ScrollingDirection.Y; content.Parent=panel
	local toolbar=frame(gui,UDim2.new(1,-24,0,48),UDim2.fromOffset(12,102))
	local toolbarLayout=Instance.new("UIGridLayout"); toolbarLayout.CellSize=UDim2.new(1/7,-4,0,48); toolbarLayout.CellPadding=UDim2.fromOffset(4,0); toolbarLayout.Parent=toolbar
	local renderPanel: ()-&gt;()
	local function open(name: string)
		currentPanel=name; panel.Visible=name~=""; menu.Visible=state~=nil and not state.playing and name==""
		request("Modal",{open=name~=""}); renderPanel()
	end
	local close=button(panel,"×",function() open("") end)
	close.Size=UDim2.fromOffset(110,44); close.Position=UDim2.new(1,-120,0,6)
	local function confirm(title: string,callback: ()-&gt;())
		content:ClearAllChildren(); vertical(content); label(content,title)
		button(content,t("confirm"),function() callback(); renderPanel() end)
		button(content,t("cancel"),renderPanel)
	end
	local function spend(title: string,action: string,payload: any)
		confirm(title,function() request(action,payload) end)
	end
	local function money(price: number): string return tostring(price).." "..t("coins") end
	local function keys(tableValue: any): {string}
		local ids={}; for id in tableValue do table.insert(ids,id) end; table.sort(ids); return ids
	end
	local function islandControls()
		for _,id in C.order do
			button(content,(if selectedIsland==id then "✓ " else "")..named(C.islands[id]),function() selectedIsland=id; renderPanel() end)
		end
	end
	local function slimeTitle(uid: string): string
		local s=state.profile.slimes[uid]; local species=C.species[s.speciesId]
		return named(if s.evolutionId then C.evolutions[s.speciesId] else species).." · "..t("level").." "..s.level.." · "..t("rank").." "..s.rank
	end
	local function teamList(recycle: boolean)
		local p=state.profile
		for _,id in keys(p.slimes) do
			local s=p.slimes[id]
			local equipped=table.find(p.team,id)~=nil
			button(content,(if equipped then "✓ " elseif s.locked then "★ " else "")..slimeTitle(id),function()
				if recycle then recycleSelection[id]=not recycleSelection[id]; renderPanel()
				else selectedSlime=id; currentPanel="slime"; renderPanel() end
			end)
			if recycle and recycleSelection[id] then label(content,t("selected").." ✓") end
		end
	end
	renderPanel=function()
		content:ClearAllChildren(); vertical(content)
		close.Text=t("close")
		if not state or currentPanel=="" then return end
		local p=state.profile
		panelTitle.Text=t(currentPanel)
		if currentPanel=="map" then
			button(content,t("returnHome"),function() open(""); request("ReturnHome") end)
			for _,id in C.order do
				local item=C.islands[id]
				label(content,named(item).." · "..(if id=="shore" then "Plastic / Metal" elseif id=="bay" then "Metal · Breaker" else "Crystal · Sweeper"))
				if p.unlockedIslands[id] then button(content,t("travel"),function() request("Travel",{island=id}); open("") end)
				else
					button(content,t("unlock")..": "..money(item.price),function() spend(named(item).." — "..money(item.price),"UnlockIsland",{island=id}) end,
						p.coins&gt;=item.price and p.unlockedIslands[C.order[item.index-1]]==true)
				end
			end
			label(content,t("guests"))
			for _,base in state.bases do
				if base.userId~=player.UserId then button(content,base.name.." · "..t("visit"),function() request("VisitBase",{userId=base.userId}); open("") end,base.guests) end
			end
		elseif currentPanel=="settings" then
			button(content,t("language")..": "..lang,function() request("UpdateSettings",{language=if lang=="ru" then "en" else "ru"}) end)
			for _,key in {"music","sound","lowEffects","reducedMotion","autoRepeat","allowGuests"} do
				button(content,t(key)..": "..t(if p.settings[key] then "active" else "inactive"),function() request("UpdateSettings",{[key]=not p.settings[key]}) end)
			end
		elseif currentPanel=="news" or currentPanel=="help" then
			label(content,t(if currentPanel=="news" then "newsText" else "helpText"))
			if p.tutorial.step&lt;7 then button(content,t("skip"),function() spend(t("skip"),"SkipTutorial",{}) end) end
		elseif currentPanel=="recycler" then
			label(content,t("preview")..": "..money(state.preview.coins)..(if p.tutorial.step==4 then " +15 "..t("coins") else ""))
			for _,material in C.materials do label(content,material..": +"..state.preview.materials[material]) end
			button(content,t("process"),function() spend(t("process").." — "..money(state.preview.coins),"ProcessCargo",{}) end,state.preview.coins&gt;0)
		elseif currentPanel=="shop" then
			for _,kind in {"tool","bag","storage","consumables","decor","trait"} do
				button(content,t(kind),function() tab=kind; renderPanel() end)
			end
			if C[tab] and table.find({"tool","bag","storage"},tab) then
				local tier=p.equipment[tab.."Tier"]; local item=C[tab]
				label(content,t(tab).." "..tier.." · "..item.values[tier])
				if item.prices[tier+1] then
					local price=item.prices[tier+1]
					button(content,t("buy").." "..t(tab).." "..(tier+1).." · "..money(price).." · "..named(C.islands[C.order[item.access[tier+1]]]),
						function() spend(t(tab).." "..(tier+1).." — "..money(price),"BuyUpgrade",{kind=tab,expectedTier=tier}) end,
						p.coins&gt;=price and p.unlockedIslands[C.order[item.access[tier+1]]]==true)
				else label(content,t("MaxTier")) end
			elseif tab=="consumables" then
				local highest=if p.unlockedIslands.cave then "cave" elseif p.unlockedIslands.bay then "bay" else "shore"
				local price=C.islands[highest].tea
				label(content,t("tea").." · "..math.max(0,p.boosts.workTeaExpiresAt-state.serverTime).."s")
				button(content,t("buy").." · "..money(price),function() spend(t("tea").." — "..money(price),"BuyTea",{}) end,p.tutorial.step&gt;=7 and p.coins&gt;=price)
			elseif tab=="decor" then
				for _,id in C.decorOrder do
					local item=C.decor[id]
					button(content,named(item).." · "..(if p.base.ownedDecor[id] then "✓" else money(item.price)),function()
						if p.base.ownedDecor[id] then chosenDecor=id; currentPanel="decor"; renderPanel()
						else spend(named(item).." — "..money(item.price),"BuyDecoration",{itemId=id}) end
					end,p.base.ownedDecor[id] or (p.coins&gt;=item.price and p.unlockedIslands[item.island]==true))
				end
			elseif tab=="trait" then
				label(content,t("traitNote"))
				button(content,t("tool"),function() selectedSlime=nil; currentPanel="trait"; renderPanel() end)
				teamList(false)
			end
		elseif currentPanel=="team" then
			label(content,t("team")..": "..#p.team.." / "..(if p.unlockedIslands.bay then 3 elseif p.tutorial.step&gt;=7 then 2 else 1))
			button(content,t("autoTeam"),function()
				local ranked=keys(p.slimes)
				local function score(id: string): number
					local s=p.slimes[id]; local species=C.species[s.speciesId]
					local power=C.islands[species.island].power*C.rarityPower[species.rarity]*(1+0.12*(s.level-1))*(1+0.1*s.rank)*(if s.evolutionId then 1.2 else 1)
					if (if s.evolutionId then C.evolutions[s.speciesId].role else species.role)=="Breaker" and state.location=="bay" then power*=1.35 end
					return power
				end
				table.sort(ranked,function(a,b) local sa,sb=score(a),score(b); return if sa==sb then a&lt;b else sa&gt;sb end)
				local limit=if p.unlockedIslands.bay then 3 elseif p.tutorial.step&gt;=7 then 2 else 1
				local team={}
				for _,id in p.team do if p.slimes[id].locked then table.insert(team,id) end end
				for _,id in ranked do if #team&lt;limit and not table.find(team,id) then table.insert(team,id) end end
				spend(t("autoTeam"),"EquipTeam",{uids=team})
			end)
			button(content,t("recycle"),function() currentPanel="recycle"; renderPanel() end)
			teamList(false)
		elseif currentPanel=="slime" then
			local id=selectedSlime
			if not id then currentPanel="team"; renderPanel(); return end
			local s=p.slimes[id]
			if not s then currentPanel="team"; renderPanel(); return end
			local species=C.species[s.speciesId]; local evo=C.evolutions[s.speciesId]
			panelTitle.Text=slimeTitle(id)
			label(content,(if lang=="en" then C.rarityEn else C.rarityRu)[species.rarity].." · "..t(if s.evolutionId then evo.role else species.role).." · "..(s.traitId or "—"))
			local equipped=table.find(p.team,id)
			button(content,t(if equipped then "unequip" else "equip"),function()
				local team=table.clone(p.team)
				if equipped then table.remove(team,equipped) else table.insert(team,id) end
				request("EquipTeam",{uids=team})
			end)
			button(content,t(if s.locked then "unlockSlime" else "lock"),function() request("LockSlime",{uid=id,locked=not s.locked}) end)
			if s.level&lt;10 then
				local price=math.ceil(20*C.islands[species.island].factor*s.level^1.7)
				button(content,t("level").." +1 · "..money(price),function() spend(t("level").." +1 — "..money(price),"LevelSlime",{uid=id,expectedLevel=s.level}) end,p.coins&gt;=price)
			end
			if s.rank&lt;3 then
				local price=C.rankPrices[s.rank+1]*C.rankFactors[species.rarity]
				button(content,t("rank").." +1 · "..price.." "..t("fragments"),function() spend(t("rank").." +1 — "..price.." "..species.island,"RankSlime",{uid=id,expectedRank=s.rank}) end,p.fragments[species.island]&gt;=price)
			end
			if evo and not s.evolutionId then
				local title=t("evolve")..": "..named(evo).." · "..money(evo.coins).." + "..evo.amount.." "..evo.material
				button(content,title,function() spend(title,"EvolveSlime",{uid=id,recipeId=evo.id}) end,s.level&gt;=3 and p.unlockedIslands[evo.island] and p.coins&gt;=evo.coins and p.materials[evo.material]&gt;=evo.amount)
			end
			button(content,t("trait"),function() currentPanel="trait"; renderPanel() end)
		elseif currentPanel=="recycle" then
			label(content,t("destructive")); teamList(true)
			local ids=keys(recycleSelection)
			local chosen={}; for _,id in ids do if recycleSelection[id] then table.insert(chosen,id) end end
			local reward={shore=0,bay=0,cave=0}
			for _,id in chosen do if p.slimes[id] then local sp=C.species[p.slimes[id].speciesId]; reward[sp.island]+=C.recycle[sp.rarity] end end
			label(content,t("preview")..": "..reward.shore.." / "..reward.bay.." / "..reward.cave.." "..t("fragments"))
			button(content,t("recycle").." ("..#chosen..")",function()
				spend(t("destructive").."\n"..t("recycle")..": "..#chosen,"RecycleSlimes",{uids=chosen})
			end,#chosen&gt;0 and #chosen&lt;=20)
		elseif currentPanel=="nursery" then
			islandControls()
			local item=C.islands[selectedIsland]; local weights=state.chances[selectedIsland]
			local total=0; for _,w in weights do total+=w end
			label(content,t("chanceNote"))
			local pity=p.incubators[selectedIsland]
			label(content,t("pity")..": "..(10-pity.sinceRare).." / "..(50-pity.sinceEpic).." / "..(200-pity.sinceLegendary))
			for i,id in C.sets[selectedIsland] do label(content,named(C.species[id])..": "..string.format("%.4f%%",weights[i]/total*100)) end
			button(content,t("incubate").." · "..money(item.incubation),function()
				spend(t("chanceNote").."\n"..money(item.incubation),"Incubate",{island=selectedIsland})
			end,p.unlockedIslands[selectedIsland] and p.coins&gt;=item.incubation)
			for _,id in C.sets[selectedIsland] do
				local species=C.species[id]; local price=C.craft[species.rarity]
				button(content,t("craft")..": "..named(species).." · "..price.." "..t("fragments"),function()
					spend(named(species).." — "..price.." "..t("fragments"),"CraftSlime",{island=selectedIsland,speciesId=id})
				end,p.unlockedIslands[selectedIsland] and p.fragments[selectedIsland]&gt;=price)
			end
		elseif currentPanel=="trait" then
			label(content,t("traitNote"))
			local offer=p.pendingTraitOffer
			if offer then
				label(content,offer.target..": "..offer.traitId)
				button(content,t("keep"),function() request("ResolveTrait",{offerId=offer.id,accept=false}) end)
				button(content,t("accept"),function() request("ResolveTrait",{offerId=offer.id,accept=true}) end)
			else
				local target=selectedSlime or "tool"
				local origin=if p.unlockedIslands.cave then "cave" elseif p.unlockedIslands.bay then "bay" else "shore"
				if target~="tool" and p.slimes[target] then origin=C.species[p.slimes[target].speciesId].island end
				local price=C.islands[origin].trait
				button(content,t("roll").." · "..money(price),function() spend(t("traitNote").."\n"..money(price),"RollTrait",{target=target}) end,p.unlockedIslands.bay and p.coins&gt;=price)
			end
		elseif currentPanel=="decor" then
			panelTitle.Text=t("decor").." · "..named(C.decor[chosenDecor])
			for i=1,12 do
				local current=p.base.decorationSlots[tostring(i)]
				button(content,t("place").." "..i.." · "..(if current then named(C.decor[current]) else "—"),function()
					spend(t("place").." "..i,"PlaceDecoration",{itemId=chosenDecor,slot=i})
				end,i&lt;=p.base.restorationTier*3 and state.location=="home")
				if current then button(content,t("clear").." "..i,function() request("PlaceDecoration",{itemId="",slot=i}) end,state.location=="home") end
			end
		elseif currentPanel=="collection" then
			label(content,t("materials")..": Plastic "..p.materials.Plastic.." · Metal "..p.materials.Metal.." · Crystal "..p.materials.Crystal)
			label(content,t("fragments")..": shore "..p.fragments.shore.." · bay "..p.fragments.bay.." · cave "..p.fragments.cave)
			local count=0; for _ in p.collections.slimeSpeciesIds do count+=1 end
			label(content,t("collection")..": "..count.." / 15")
			for _,id in C.speciesOrder do label(content,(if p.collections.slimeSpeciesIds[id] then "✓ " else "— ")..named(C.species[id])) end
			for _,island in C.order do for family=1,3 do for rarity=1,5 do
				local key=island.."/"..family.."/"..rarity
				label(content,named(C.islands[island]).." · "..C.materials[family].." · "..(if lang=="en" then C.rarityEn else C.rarityRu)[rarity]..": "..(p.collections.junkCountsByKey[key] or 0))
			end end end
			for _,recipe in C.evolutions do label(content,(if p.collections.evolutions[recipe.id] then "✓ " else "— ")..named(recipe)) end
		elseif currentPanel=="event" then
			label(content,t("eventNote"))
			label(content,tostring(state.event.hp).." / "..tostring(state.event.maxHp).." · "..tostring(state.event.cycles).." / 10")
			button(content,t("eventJoin"),function() open(""); request("SelectEvent") end,state.event.active)
		end
		panelRevision=p.revision
	end
	local function rebuildNavigation()
		menu:ClearAllChildren(); vertical(menu)
		button(menu,t("play"),function() request("Play"); open("") end)
		button(menu,t("settings"),function() open("settings") end)
		button(menu,t("news"),function() open("news") end)
		for _,child in toolbar:GetChildren() do if child:IsA("GuiButton") then child:Destroy() end end
		for _,name in {"map","team","collection","help","settings","event","menu"} do
			button(toolbar,t(name),function()
				if name=="menu" then request("Pause"); open("") else open(name) end
			end)
		end
	end
	rebuildNavigation()
	local station=button(gui,"",function()
		if goalStation then open(goalStation); if goalStation=="nursery" then request("ViewNursery") end end
	end)
	station.Size=UDim2.fromOffset(245,48); station.Position=UDim2.new(0.5,-122,1,-64); station.Visible=false
	remote.OnClientEvent:Connect(function(snapshot: any)
		if snapshot.phase~="Ready" then
			hud.Text=t(if snapshot.phase=="LoadError" then "loadError" else "loading")
			if snapshot.phase=="LoadError" then notify(t("loadError").." "..tostring(snapshot.errorCode)) end
			return
		end
		if snapshot.viewRevision&lt;=lastView then return end
		lastView=snapshot.viewRevision
		local oldLang=lang
		state=snapshot; state.receivedAt=os.clock(); lang=state.profile.settings.language
		audio.settings(state.profile.settings)
		local cargo=0; for _,g in state.profile.cargo do cargo+=g.count end
		if cargo&gt;lastCargo then audio.play("collect") end
		lastCargo=cargo
		renderer.update(snapshot)
		menu.Visible=not state.playing and currentPanel==""; toolbar.Visible=state.playing
		if oldLang~=lang then rebuildNavigation() end
		if snapshot.requestId and pending and pending.request.requestId==snapshot.requestId and snapshot.errorCode~="Saving" then
			pending=nil
			if snapshot.errorCode then notify(t(snapshot.errorCode)) else
				local result=snapshot.result
				notify(t("completed")..(if result and result.speciesId then " · "..named(C.species[result.speciesId]) else ""))
				audio.play("confirm")
			end
		elseif snapshot.errorCode then notify(t(snapshot.errorCode)) end
		if state.busy then notify(t("saving")) end
		if state.profile.pendingTraitOffer and currentPanel=="" then open("trait") end
		if currentPanel~="" and (panelRevision~=state.profile.revision or oldLang~=lang) then renderPanel() end
	end)
	local function targetAt(pos: Vector2)
		if not state or not state.playing or currentPanel~="" or state.busy then return end
		local camera=workspace.CurrentCamera; if not camera then return end
		local ray=camera:ScreenPointToRay(pos.X,pos.Y)
		local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Include; params.FilterDescendantsInstances={renderer.folder}
		local hit=workspace:Raycast(ray.Origin,ray.Direction*240,params)
		if hit then
			if hit.Instance:GetAttribute("EventTarget") then request("SelectEvent")
			elseif hit.Instance:GetAttribute("NodeId") then request("SelectTarget",{nodeId=hit.Instance:GetAttribute("NodeId")}) end
		end
	end
	Input.InputBegan:Connect(function(input,processed)
		if processed then return end
		if input.UserInputType==Enum.UserInputType.MouseButton1 then targetAt(Vector2.new(input.Position.X,input.Position.Y))
		elseif input.KeyCode==Enum.KeyCode.E and goalStation then open(goalStation); if goalStation=="nursery" then request("ViewNursery") end
		elseif input.KeyCode==Enum.KeyCode.Escape and currentPanel~="" then open("") end
	end)
	Input.TouchTapInWorld:Connect(function(pos,processed) if not processed then targetAt(pos) end end)
	task.spawn(function()
		while true do
			task.wait(0.3)
			if not state then request("Sync"); continue end
			local p=state.profile
			local amount=0; for _,g in p.cargo do amount+=g.count end
			if lastGoal~=p.tutorial.step then lastGoal=p.tutorial.step; goalChangedAt=os.clock() end
			local location=if C.islands[state.location] then named(C.islands[state.location]) else t("home")
			hud.Text="SLIME SALVAGE · "..location.." · "..money(p.coins).." · "..t("bag").." "..amount.."/"..C.bag.values[p.equipment.bagTier]
				.."\n"..t("goal"..p.tutorial.step)
			if amount&gt;=C.bag.values[p.equipment.bagTier] then hud.Text..="\n"..t("BagFull") end
			if p.tutorial.step&lt;7 and os.clock()-goalChangedAt&gt;30 then hud.Text..="\n"..t("hint") end
			local remaining=state.event.nextAt-(state.serverTime+(os.clock()-(state.receivedAt or os.clock())))
			if state.returning then hud.Text..="\n"..t("returnHome") end
			if state.event.active then hud.Text..="\n"..t("event").." · "..math.ceil(state.event.hp).." HP"
			elseif remaining&lt;=30 then hud.Text..="\n"..t("event").." · "..math.max(0,math.floor(remaining)).."s" end
			goalStation=nil
			local root=if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
			if root and root:IsA("BasePart") and state.location~="visit" then
				local origin=if C.islands[state.location] then Vector3.new(C.islands[state.location].x,0,0)
					else Vector3.new(((state.slot-1)%4-1.5)*150,0,-240-math.floor((state.slot-1)/4)*150)
				local range=16
				for name,offset in {recycler=Vector3.new(-16,4,18),shop=Vector3.new(16,3,18),nursery=Vector3.new(-17,2,-15)} do
					local d=(root.Position-origin-offset).Magnitude
					if d&lt;range then goalStation=name; range=d end
				end
			end
			station.Visible=goalStation~=nil and state.playing and currentPanel==""
			station.Text="E · "..t(goalStation or "recycler")
			if pending and os.clock()-pending.sentAt&gt;10 then
				pending.sentAt=os.clock(); remote:FireServer(pending.request)
			end
		end
	end)
end
return Client
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX347">
        <Properties>
          <string name="Name">BetaRenderer</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local C=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Catalog"))
local text=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Strings"))
local Renderer={}
local colors={Color3.fromRGB(145,218,112),Color3.fromRGB(121,204,230),Color3.fromRGB(93,155,106),
	Color3.fromRGB(235,198,110),Color3.fromRGB(255,223,96),Color3.fromRGB(149,176,174),
	Color3.fromRGB(170,154,131),Color3.fromRGB(158,175,204),Color3.fromRGB(231,138,91),
	Color3.fromRGB(104,142,165),Color3.fromRGB(163,143,217),Color3.fromRGB(233,193,230),
	Color3.fromRGB(130,202,208),Color3.fromRGB(202,172,240),Color3.fromRGB(235,231,255)}
local function part(parent: Instance,name: string,size: Vector3,offset: Vector3,color: Color3): Part
	local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=offset; p.Color=color
	p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.Parent=parent; return p
end
local function label(parent: Instance,text: string): TextLabel
	local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(170,48); gui.StudsOffset=Vector3.new(0,3,0)
	gui.MaxDistance=45; gui.AlwaysOnTop=true; gui.Parent=parent
	local l=Instance.new("TextLabel"); l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=0.2
	l.BackgroundColor3=Color3.fromRGB(25,46,50); l.TextColor3=Color3.new(1,1,1); l.TextSize=13
	l.TextWrapped=true; l.Font=Enum.Font.GothamMedium; l.Text=text; l.Parent=gui; return l
end
function Renderer.start(): any
	local folder=Instance.new("Folder"); folder.Name="BetaClientArt"; folder.Parent=workspace
	local nodes: {[number]: any}={}; local slimes: {[string]: any}={}
	local highlight=Instance.new("Highlight"); highlight.FillTransparency=0.8
	highlight.OutlineColor=Color3.fromRGB(255,232,133); highlight.Parent=folder
	local eventModel=Instance.new("Model"); eventModel.Name="GiantWreck"
	local wreck=part(eventModel,"Wreck",Vector3.new(8,7,7),Vector3.zero,Color3.fromRGB(143,119,92))
	wreck:SetAttribute("EventTarget",true); eventModel.PrimaryPart=wreck
	local eventLabel=label(wreck,""); eventModel:PivotTo(CFrame.new(400,5,-50))
	local pointer=part(folder,"TutorialPointer",Vector3.one,Vector3.zero,Color3.new(1,1,1))
	pointer.Transparency=1; pointer.CanQuery=false
	local pointerLabel=label(pointer,"▼"); pointerLabel.TextSize=36; pointerLabel.BackgroundTransparency=1
	local snapshot: any=nil
	local function makeSlime(speciesId: string,evolved: boolean): Model
		local model=Instance.new("Model"); model.Name=speciesId
		local index=table.find(C.speciesOrder,speciesId) or 1
		local color=colors[index]
		local body=part(model,"Body",Vector3.new(2.7,2,2.5),Vector3.zero,color)
		body.Shape=Enum.PartType.Ball; body.Material=if evolved then Enum.Material.Metal else Enum.Material.SmoothPlastic
		for _,x in {-0.5,0.5} do
			local eye=part(model,"Eye",Vector3.new(0.23,0.34,0.2),Vector3.new(x,0.2,-1.12),Color3.fromRGB(25,45,46)); eye.Shape=Enum.PartType.Ball
		end
		local role=if evolved then C.evolutions[speciesId].role else C.species[speciesId].role
		local accent=part(model,"Role",Vector3.new(0.45,1,0.4),Vector3.new(0.2,1.3,0),color:Lerp(Color3.new(1,1,1),0.3))
		accent.Shape=if role=="Collector" then Enum.PartType.Ball elseif role=="Support" then Enum.PartType.Cylinder else Enum.PartType.Block
		if role=="Breaker" then accent.Size=Vector3.new(2.6,0.4,0.7) end
		if role=="Sweeper" then accent.CFrame*=CFrame.Angles(0,0,0.7) end
		if C.species[speciesId].rarity==5 then
			local crown=part(model,"Crown",Vector3.new(2.3,0.3,1.8),Vector3.new(0,1.7,0),Color3.fromRGB(246,209,104))
			crown.Material=Enum.Material.Neon
		end
		for _,p in model:GetChildren() do if p:IsA("BasePart") then p.CanQuery=false end end
		model.PrimaryPart=body; return model
	end
	RunService.RenderStepped:Connect(function(dt)
		if not snapshot then return end
		for _,item in slimes do
			local owner=Players:GetPlayerByUserId(item.userId)
			local root=if owner and owner.Character then owner.Character:FindFirstChild("HumanoidRootPart") else nil
			if not root or not root:IsA("BasePart") then item.model.Parent=nil; continue end
			item.model.Parent=folder
			local destination=root.Position+Vector3.new((item.index-2)*3.5,-1.8,3.5)
			if item.target then destination=Vector3.new(item.target[1],item.target[2],item.target[3])+Vector3.new(item.index*2-4,0,2) end
			if not snapshot.profile.settings.reducedMotion then destination+=Vector3.new(0,math.abs(math.sin(os.clock()*5+item.index))*0.45,0) end
			if (item.model:GetPivot().Position-destination).Magnitude&gt;70 then item.model:PivotTo(CFrame.new(destination))
			else item.model:PivotTo(item.model:GetPivot():Lerp(CFrame.new(destination),1-math.exp(-dt*8))) end
		end
	end)
	return {
		folder=folder,
		update=function(state: any)
			snapshot=state
			local seen={}
			for _,node in state.nodes do
				seen[node.id]=true
				local entry=nodes[node.id]
				if not entry or entry.family~=node.family then
					if entry then entry.model:Destroy() end
					local model=Instance.new("Model"); model.Name="Junk"..tostring(node.id)
					local materialColors={Color3.fromRGB(216,177,115),Color3.fromRGB(148,177,190),Color3.fromRGB(171,139,216)}
					local p=part(model,"Body",Vector3.new(2.6,2.1,2.6),Vector3.zero,materialColors[node.family])
					p.Shape=if node.family==1 then Enum.PartType.Cylinder elseif node.family==2 then Enum.PartType.Block else Enum.PartType.Ball
					p.Material=if node.family==2 then Enum.Material.Metal elseif node.family==3 then Enum.Material.Glass else Enum.Material.SmoothPlastic
					p:SetAttribute("NodeId",node.id); model.PrimaryPart=p
					entry={model=model,part=p,label=label(p,""),family=node.family}; nodes[node.id]=entry
				end
				entry.model:PivotTo(CFrame.new(node.position[1],node.position[2],node.position[3]))
				entry.model.Parent=if node.hp&gt;0 then folder else nil
				local rarityNames=if state.profile.settings.language=="en" then C.rarityEn else C.rarityRu
				entry.label.Text=rarityNames[node.rarity].." · "..text(node.material,state.profile.settings.language).."\n"..math.ceil(node.hp).." / "..node.maxHp
				entry.label.Parent.AlwaysOnTop=not state.profile.settings.lowEffects
			end
			for id,entry in nodes do if not seen[id] then entry.model:Destroy(); nodes[id]=nil end end
			local target=if type(state.selected)=="number" then nodes[state.selected] else nil
			if not target and state.profile.tutorial.step&lt;=3 then
				local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local range=math.huge
				if root and root:IsA("BasePart") then
					for _,candidate in nodes do local d=(root.Position-candidate.part.Position).Magnitude
						if d&lt;range then range=d; target=candidate end end
				end
			end
			highlight.Adornee=if target then target.model else nil
			highlight.FillTransparency=if state.profile.settings.lowEffects then 1 else 0.8
			local tutorialStep=state.profile.tutorial.step
			pointer.Parent=if tutorialStep&lt;7 and state.playing then folder else nil
			if tutorialStep&lt;=3 and target then pointer.Position=target.part.Position+Vector3.new(0,2,0)
			elseif tutorialStep&gt;=4 and tutorialStep&lt;=6 then
				local origin=if C.islands[state.location] then Vector3.new(C.islands[state.location].x,0,0)
					else Vector3.new(((state.slot-1)%4-1.5)*150,0,-240-math.floor((state.slot-1)/4)*150)
				local offset=if tutorialStep==4 then Vector3.new(-16,6,18) elseif tutorialStep==5 then Vector3.new(16,6,18) else Vector3.new(-17,6,-15)
				pointer.Position=origin+offset
			end
			seen={}
			for _,companion in state.companions do
				for index,s in companion.team do
					local key=tostring(companion.userId)..":"..s.uid; seen[key]=true
					local signature=s.speciesId..tostring(s.evolutionId)
					if not slimes[key] or slimes[key].signature~=signature then
						if slimes[key] then slimes[key].model:Destroy() end
						slimes[key]={model=makeSlime(s.speciesId,s.evolutionId~=nil),signature=signature,userId=companion.userId,index=index}
					end
					slimes[key].index=index; slimes[key].target=companion.target
				end
			end
			for key,item in slimes do if not seen[key] then item.model:Destroy(); slimes[key]=nil end end
			eventModel.Parent=if state.event.active then folder else nil
			eventLabel.Text=if state.profile.settings.language=="en" then "Giant Wreck" else "Большой обломок"
			eventLabel.Text..="\n"..tostring(math.ceil(state.event.hp)).." / "..tostring(state.event.maxHp)
		end,
	}
end
return Renderer
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX348">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
require(script.Parent:WaitForChild("BetaClient")).start()
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>